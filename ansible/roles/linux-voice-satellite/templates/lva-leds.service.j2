[Unit]
Description=ReSpeaker LED service for linux-voice-assistant
After=linux-voice-assistant.service
BindsTo=linux-voice-assistant.service

[Service]
Type=simple
User=root
ExecStart=/opt/linux-voice-assistant/.venv/bin/python /opt/lva-leds.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
