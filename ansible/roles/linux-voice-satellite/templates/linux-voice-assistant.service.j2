[Unit]
Description=Linux Voice Assistant ({{ satellite_name }})
After=network.target sound.target

[Service]
Type=simple
User=anorum
SupplementaryGroups=audio
Environment=PYTHONUNBUFFERED=1

# PipeWire pulse compat socket (user 1000 = anorum)
Environment=PULSE_SERVER=unix:/run/user/1000/pulse/native
Environment=XDG_RUNTIME_DIR=/run/user/1000

ExecStart=/opt/linux-voice-assistant/.venv/bin/python -m linux_voice_assistant \
  --name "{{ satellite_name }} Satellite" \
  --wake-model okay_nabu \
  --port {{ satellite_port }} \
  --audio-input-device "{{ audio_input_device }}" \
  --stop-model stop \
  --refractory-seconds {{ refractory_seconds }}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
