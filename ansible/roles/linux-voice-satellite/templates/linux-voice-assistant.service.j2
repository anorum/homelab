[Unit]
Description=Linux Voice Assistant ({{ satellite_name }})
# ESPHome satellite — Home Assistant discovers this device via mDNS on port 6053.
# No HA host config needed here; HA connects to us.
After=network.target sound.target

[Service]
Type=simple
User=anorum
SupplementaryGroups=audio
Environment=PYTHONUNBUFFERED=1

# PipeWire pulse compat socket (user 1000 = anorum)
Environment=PULSE_SERVER=unix:/run/user/1000/pulse/native
Environment=XDG_RUNTIME_DIR=/run/user/1000

ExecStart=/opt/linux-voice-assistant/.venv/bin/python -m linux_voice_assistant \
  --name "{{ satellite_name }} Satellite" \
  --wake-model hey_jarvis \
  --port 6053 \
  --audio-input-device "Built-in Audio Stereo" \
  --stop-model stop \
  --refractory-seconds 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
