<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.homelab.mcp</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/alexnorum/repos/homelab/mac-mini/mcp-server/run.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>MCP_PORT</key>
        <string>8881</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/Users/alexnorum/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/alexnorum/repos/homelab/mac-mini/mcp-server</string>

    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/homelab-mcp.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/homelab-mcp.log</string>

    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
